# Required
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# Optional: narrator voice IDs (run `node scripts/design-voices.mjs` to create original ones)
VOICE_WARM=
VOICE_CINEMATIC=
VOICE_BROODING=
VOICE_ADVENTURER=

# Optional overrides. Model names change, so keep them out of the code.
ELEVENLABS_MODEL=eleven_multilingual_v2
GEMINI_MODEL=gemini-3.5-flash
